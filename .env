# Plan d'adressage du lab. Un seul endroit a modifier en cas de conflit.
#
# Docker alloue automatiquement dans 172.17.0.0/12 et 192.168.0.0/16.
# Si un autre projet a deja pris une plage, docker compose up refuse de
# creer le reseau avec "Pool overlaps with other one on this address space".
# Dans ce cas, changez juste le 99 ci dessous par un autre nombre.

LAN_SUBNET=10.99.0.0/24
LAN_GATEWAY=10.99.0.1

IP_SERVEUR=10.99.0.10
IP_CLIENT=10.99.0.20
IP_ATTAQUANT=10.99.0.30